<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="black">#FF000000</color>
    <color name="emerald_100">#D1FAE5</color>
    <color name="emerald_50">#ECFDF5</color>
    <color name="emerald_500">#10B981</color>
    <color name="emerald_600">#059669</color>
    <color name="emerald_700">#047857</color>
    <color name="emerald_800">#065F46</color>
    <color name="emerald_900">#064E3B</color>
    <color name="gray_100">#F3F4F6</color>
    <color name="gray_200">#E5E7EB</color>
    <color name="gray_50">#F9FAFB</color>
    <color name="gray_500">#6B7280</color>
    <color name="gray_800">#1F2937</color>
    <color name="gray_900">#111827</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">SpiceMart</string>
    <string name="app_url">https://naninice2000.github.io/SpiceMart/</string>
    <string name="btn_retry">Retry Connection</string>
    <string name="loading">Loading SpiceMart…</string>
    <string name="offline_message">Please check your Wi-Fi or mobile data connection and try again to view products and place orders.</string>
    <string name="offline_title">No Internet Connection</string>
    <style name="Theme.SpiceMart" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/emerald_600</item>
        <item name="colorPrimaryVariant">@color/emerald_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/emerald_600</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" ns1:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">true</item>
    </style>
    <style name="Theme.SpiceMart.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/emerald_600</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SpiceMart</item>
    </style>
</resources>